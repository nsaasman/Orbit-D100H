<Window x:Class="OrbitD100H.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OrbitD100H.App" Title="Orbit D100H" Icon="Assets/OrbitD100H.ico"
        SizeToContent="WidthAndHeight" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" SizeChanged="WindowSizeChanged" LocationChanged="WindowLocationChanged">
  <ScrollViewer x:Name="WindowScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Grid.ColumnSpan="3">
        <TextBlock Text="Orbit D100H" FontSize="30" FontWeight="SemiBold" />
        <TextBlock x:Name="ConnectionText" Margin="0,4,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
      </StackPanel>
      <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
      <TextBlock Text="{DynamicResource L_Language}" VerticalAlignment="Center" Margin="0,0,8,8" />
      <ComboBox x:Name="LanguageCombo" Width="152" Margin="0,0,16,8" VerticalAlignment="Center"
                AutomationProperties.Name="{DynamicResource L_Language}" SelectionChanged="ChangeLanguage" SelectedValuePath="Tag">
        <ComboBoxItem Tag="nl" Content="Nederlands" /><ComboBoxItem Tag="en" Content="English" />
        <ComboBoxItem Tag="de" Content="Deutsch" /><ComboBoxItem Tag="fr" Content="Français" /><ComboBoxItem Tag="es" Content="Español" />
      </ComboBox>
      <ToggleButton x:Name="DarkThemeCheck" Content="{DynamicResource L_DarkTheme}" Style="{StaticResource ThemeSwitch}"
                    AutomationProperties.Name="{DynamicResource L_ThemeSwitch}" VerticalAlignment="Center" Margin="0,0,16,8" Click="ChangeTheme" />
      <Button x:Name="PauseButton" Margin="0,0,0,8" Content="{DynamicResource L_Pause}" VerticalAlignment="Center" Click="TogglePause" />
      </WrapPanel>
    </Grid>
    <Grid x:Name="BodyGrid" Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border x:Name="ProfilePanel" Background="{DynamicResource Surface}" CornerRadius="8" Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{DynamicResource L_Profiles}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="{DynamicResource L_RoutingHelp}"
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,16" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button Content="{DynamicResource L_AddProgram}" Click="AddProgram" Margin="0,0,0,8" />
            <Button x:Name="RemoveButton" Content="{DynamicResource L_RemoveProfile}" Click="RemoveProgram" Margin="0,0,0,16" />
            <CheckBox x:Name="HapticFeedbackCheck" Click="MarkDirty"
                      ToolTip="{DynamicResource L_HapticTip}" Margin="0,0,0,12"
                      AutomationProperties.Name="{DynamicResource L_Haptic}">
              <TextBlock Text="{DynamicResource L_Haptic}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox x:Name="StartupCheck" Content="{DynamicResource L_Startup}" Click="MarkDirty" />
            <TextBlock Text="{DynamicResource L_CloseHelp}"
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,0" />
          </StackPanel>
          <ListBox x:Name="ProfilesList" SelectionChanged="SelectProfile" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center">
              <TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding Name}" />
                <Style.Triggers><DataTrigger Binding="{Binding ProgramPath}" Value="{x:Null}">
                  <Setter Property="Text" Value="{DynamicResource L_General}" />
                </DataTrigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="EditorScroll" Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
          <Border x:Name="RoutingBanner" Background="{DynamicResource Banner}" Padding="16" CornerRadius="8" Margin="0,0,0,16" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="{DynamicResource L_EnableRouting}" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource L_RoutingInstructions}"
                         TextWrapping="Wrap" Margin="0,4,0,12" />
              <Button Content="{DynamicResource L_OpenMouseSettings}" HorizontalAlignment="Left" Click="OpenMouseSettings" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="24" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="{DynamicResource L_EditProfile}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
              <TextBlock x:Name="ProfileTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="ProfilePath" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,4,0,24" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{DynamicResource L_DialDoes}" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Margin="0,0,24,0" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="{DynamicResource L_DialFunction}">
                      <RadioButton x:Name="ScrollDialButton" GroupName="DialMode" Content="{DynamicResource L_Scroll}" Style="{StaticResource SegmentOption}"
                                   AutomationProperties.Name="{DynamicResource L_DialScroll}" Checked="DialModeChanged" />
                      <RadioButton x:Name="VolumeDialButton" GroupName="DialMode" Content="{DynamicResource L_Volume}" Style="{StaticResource SegmentOption}"
                                   AutomationProperties.Name="{DynamicResource L_DialVolume}" Checked="DialModeChanged" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <CheckBox x:Name="InvertCheck" Grid.Column="1" Content="{DynamicResource L_Invert}" VerticalAlignment="Bottom" Click="MarkDirty" />
              </Grid>
              <StackPanel x:Name="ScrollSettings">
              <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource L_ScrollMode}" FontWeight="SemiBold" /><TextBlock x:Name="SpeedLabel" Grid.Column="1" TextWrapping="Wrap" MaxWidth="240" Foreground="{DynamicResource Muted}" />
              </Grid>
              <Slider x:Name="SpeedSlider" Minimum="1" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                      ValueChanged="SpeedChanged" Margin="0,12,0,8" AutomationProperties.Name="{DynamicResource L_ScrollSpeed}" />
              <ComboBox x:Name="ModeCombo" SelectionChanged="MarkDirty" Margin="0,0,0,8" HorizontalAlignment="Left">
                <ComboBoxItem Content="{DynamicResource L_Steps}" /><ComboBoxItem Content="{DynamicResource L_Smooth}" />
              </ComboBox>
              <TextBlock Text="{DynamicResource L_ScrollHelp}"
                         TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="24">
            <StackPanel>
              <TextBlock Text="{DynamicResource L_Buttons}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource L_ButtonsHelp}"
                         TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,16" />
              <Grid>
                <Grid x:Name="ButtonLayoutGrid">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <local:DeviceDiagram x:Name="Diagram" VerticalAlignment="Top" />
                <StackPanel x:Name="MappingEditor" Grid.Column="2">
                  <StackPanel x:Name="MappingsPanel" />
                  <TextBlock Text="{DynamicResource L_ShortcutHelp}"
                             TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" />
                </StackPanel>
                </Grid>
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock Text="{DynamicResource L_AdminHelp}"
                     TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,16,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="ActivityText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
        <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Margin="0,4,16,0" />
      </StackPanel>
      <Button x:Name="SaveButton" Grid.Column="1" Content="{DynamicResource L_Save}" Click="SaveClick" VerticalAlignment="Center"
              Background="{DynamicResource SavedBackground}" BorderBrush="{DynamicResource SavedBorder}" Margin="0" />
    </Grid>
  </Grid>
  </ScrollViewer>
</Window>
